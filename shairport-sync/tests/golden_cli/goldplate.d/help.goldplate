{
    "working_directory": "..",
    "command": "timeout",
    "arguments": [
        "8",
        "./goldplate.d/shairport-sync-bin",
        "-h"
    ],
    "asserts": [
        {
            "exit_code": 0
        },
        {
            "stdout": "goldplate.d/help.stdout",
            "post_process": [
                {
                    "pattern": "^[ \\t]*[0-9]+\\.[0-9]+[ \\t]+",
                    "replacement": ""
                },
                {
                    "pattern": "\\[[ \\t]*[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]+\\]",
                    "replacement": ""
                }
            ]
        },
        {
            "stderr": "goldplate.d/help.stderr",
            "post_process": [
                {
                    "pattern": "^[ \\t]*[0-9]+\\.[0-9]+[ \\t]+",
                    "replacement": ""
                },
                {
                    "pattern": "\\[[ \\t]*[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]+\\]",
                    "replacement": ""
                }
            ]
        }
    ]
}
