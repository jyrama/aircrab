{
    "working_directory": "..",
    "command": "timeout",
    "arguments": [
        "8",
        "./goldplate.d/shairport-sync-bin",
        "-c",
        "configs/broken.conf"
    ],
    "asserts": [
        {
            "exit_code": 1
        },
        {
            "stdout": "goldplate.d/config_broken.stdout",
            "post_process": [
                {
                    "pattern": "^[ \\t]*[0-9]+\\.[0-9]+[ \\t]+",
                    "replacement": ""
                },
                {
                    "pattern": "\\[[ \\t]*[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]+\\]",
                    "replacement": ""
                }
            ]
        },
        {
            "stderr": "goldplate.d/config_broken.stderr",
            "post_process": [
                {
                    "pattern": "^[ \\t]*[0-9]+\\.[0-9]+[ \\t]+",
                    "replacement": ""
                },
                {
                    "pattern": "\\[[ \\t]*[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]+\\]",
                    "replacement": ""
                }
            ]
        }
    ]
}
